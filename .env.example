# ------------------------------------------------------------------
# RehabX AI — environment variables template.
# Copy to `.env` (root) and set real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# --- Database -----------------------------------------------------
# PostgreSQL recommended for production. SQLite works for local dev.
# DATABASE_URL=postgresql+psycopg://rehabx:rehabx@localhost:5432/rehabx
DATABASE_URL=sqlite:///./backend/rehabx.db

# --- Security -----------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Storage ------------------------------------------------------
# Local filesystem storage (default). Set STORAGE_BACKEND=s3 for S3-compatible.
STORAGE_BACKEND=local
STORAGE_DIR=./backend/storage
STORAGE_PUBLIC_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Upload limits (bytes) ----------------------------------------
MAX_UPLOAD_BYTES=15728640
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/jpg

# --- AI / Inference ------------------------------------------------
# Optional; the backend calls the AI CLI via subprocess using these paths.
# HF_TOKEN=  # optional: Hugging Face token if a dataset (e.g. MURA mirror) is gated
AI_INFERENCE_CLI=python
AI_MODEL_ROOT=./models
AI_CLASSIFIER_CHECKPOINT=./models/checkpoints/classifier/best.pt
AI_SEGMENTATION_CHECKPOINT=./models/checkpoints/segmentation/best.pt
AI_INFERENCE_TIMEOUT_SECONDS=600

# --- Frontend ------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Audit log ------------------------------------------------------
AUDIT_LOG_PATH=./backend/logs/audit.log

# --- Email (password reset) ------------------------------------------
# Leave SMTP_HOST empty to disable sending (dev mode logs instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@rehabx.local
SMTP_USE_TLS=true
FRONTEND_BASE_URL=http://localhost:3000

# --- CORS -----------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
